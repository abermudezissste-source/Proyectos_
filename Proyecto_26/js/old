// Carga automática del excel
let dataEstado = []
let dataFiltrada = []
let paginaActual = 1
const pageSize = 25

document.addEventListener('DOMContentLoaded', () => {
  fetch('Base.xlsx')
    .then(r => r.arrayBuffer())
    .then(buf => procesarExcel(buf))
})

//Procesar Excel + filtrar por EstadoId
function procesarExcel(buffer) {
  const wb = XLSX.read(buffer, { type: 'array' })
  const sheet = wb.Sheets[wb.SheetNames[0]]
  let data = XLSX.utils.sheet_to_json(sheet)

//Filtro clave por Estado
 dataEstado = data.filter(d =>
    d.EstadoId &&
    d.EstadoId.toString().toUpperCase() === estadoId.toUpperCase()
  )
  statusBox.textContent = `Datos cargados (${dataEstado.length} registros)`
  cargarFiltros()
}

//Filtros dependientes del Estado
function cargarFiltros() {
  cargarSelect('selTipo', 'Tipo')
  cargarSelect('selEBDI', 'EBDI')
  cargarSelect('selEstrato', 'Estrato')
  cargarSelect('selGenero', 'Genero')
}

function cargarSelect(id, campo) {
  const sel = document.getElementById(id);
  sel.innerHTML = '<option value="">Todos</option>';

  [...new Set(dataEstado.map(d => d[campo]))]
    .filter(Boolean)
    .sort()
    .forEach(v => {
      sel.innerHTML += `<option value="${v}">${v}</option>`;
    });
}

function filtrar() {
  dataFiltrada = dataEstado.filter(d =>
    (!selTipo.value || d.Tipo === selTipo.value) &&
    (!selEBDI.value || d.EBDI == selEBDI.value) &&
    (!selEstrato.value || d.Estrato === selEstrato.value) &&
    (!selGenero.value || d.Genero === selGenero.value)
  )
  render()
}

