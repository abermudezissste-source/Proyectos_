//<--Exportar Excel por EBDI-->
document.getElementById('btnExportEBDI').addEventListener('click', () => {
  const wb = XLSX.utils.book_new()

  Object.entries(dataFiltrada.reduce((a,d)=>{
    (a[d.EBDI]??=[]).push(d); return a
  },{})).forEach(([ebdi,rows])=>{
    const ws = XLSX.utils.json_to_sheet(rows)
    XLSX.utils.book_append_sheet(wb, ws, `EBDI_${ebdi}`)
  })

  XLSX.writeFile(wb, `Matriculas_${estadoId}.xlsx`)
})


