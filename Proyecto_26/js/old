// ===============================
// Utilidades
// ===============================
const promedio = (arr, campo) => {
  if (!arr.length) return "0.0";
  const suma = arr.reduce((s, r) => s + (+r[campo] || 0), 0);
  return (suma / arr.length).toFixed(1);
};

const obtenerUltimoRegistro = (arr) => {
  if (!arr.length) return null;
  return [...arr].reduce((a, b) =>
    new Date(a["Fecha medición"]) > new Date(b["Fecha medición"]) ? a : b
  );
};

// ===============================
// Render EBDI → Matrículas
// ===============================
function render() {
  const cont = document.getElementById("resultado");
  if (!cont) return;
  cont.innerHTML = "";
}

// 1) Construir pares (EBDI, Matrícula)
  const mapa = new Map();

  dataFiltrada.forEach(r => {
    const key = `${r.EBDI}||${r.Matricula}`;
    if (!mapa.has(key)) {
      mapa.set(key, {
        EBDI: r.EBDI,
        Matricula: r.Matricula,
        registros: []
      });
    }
    mapa.get(key).registros.push(r);
  });

  // 2) Convertir a arreglo y ordenar
  const pares = [...mapa.values()].sort((a, b) =>
    a.EBDI.localeCompare(b.EBDI) ||
    a.Matricula.localeCompare(b.Matricula)
  );

  // 3) Paginación GLOBAL por pares
  const totalPares = pares.length;
  const inicio = (page - 1) * pageSize;
  const visibles = pares.slice(inicio, inicio + pageSize);

  // 4) Agrupar los visibles por EBDI
  const porEBDI = {};
  visibles.forEach(p => {
    porEBDI[p.EBDI] ??= [];
    porEBDI[p.EBDI].push(p);
  });

  // 5) Render
  Object.entries(porEBDI).forEach(([ebdi, lista]) => {
    const detEBDI = document.createElement("details");
    detEBDI.open = true;

    const sumEBDI = document.createElement("summary");
    sumEBDI.innerHTML = `<b>EBDI:</b> ${ebdi} <span class="muted">(matrículas: ${lista.length})</span>`;
    detEBDI.appendChild(sumEBDI);

    lista.forEach(p => {
      const detMat = document.createElement("details");

      const sumMat = document.createElement("summary");
      sumMat.innerHTML = `<b>Matrícula:</b> ${p.Matricula}
        <span class="muted">Registros: ${p.registros.length}</span>`;
      detMat.appendChild(sumMat);

      const ultimo = obtenerUltimoRegistro(p.registros);

      const box = document.createElement("div");
      box.className = "mono";
      box.style.marginTop = "6px";

      box.innerHTML = `
        <div><b>Última medición:</b> ${ultimo ? ultimo["Fecha medición"] : "—"}</div>
        <div>IMC prom.: ${promedio(p.registros, "IMC")}</div>
        <div>Peso prom.: ${promedio(p.registros, "Peso")}</div>
        <div>Talla prom.: ${promedio(p.registros, "Talla")}</div>
      `;

      detMat.appendChild(box);
      detEBDI.appendChild(detMat);
    });

    cont.appendChild(detEBDI);
  });

  // 6) Info de paginación (si la tienes)
const pagerInfo = document.getElementById("pagerInfo");
if (pagerInfo) {
  pagerInfo.textContent =
    `Mostrando ${visibles.length} de ${totalPares} pares (EBDI/Matrícula)`;
}


